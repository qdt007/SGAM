NODE_ENV=development
PORT=5000
TZ=Asia/Ho_Chi_Minh

DATABASE_URL="postgresql://user:password@localhost:5432/projectmanagement"

JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list. Must match the deployed frontend origin exactly, no trailing slash.
CLIENT_URL=http://localhost:5173
# Allow https://*.vercel.app preview deploys through CORS. Off unless you need it.
ALLOW_VERCEL_PREVIEWS=false

# Leave REDIS_HOST unset (or localhost) and the notification/email queues run without Redis.
REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Project Manager <noreply@yourapp.com>"

# local     = write to UPLOADS_DIR on disk (dev; wiped on every redeploy in the cloud)
# cloudinary = upload to Cloudinary, needs the three keys below (production)
STORAGE_TYPE=local
UPLOADS_DIR=uploads
MAX_FILE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pm-uploads

# Google sign-in. Create an OAuth client at console.cloud.google.com, type "Web application".
# Authorized redirect URI must equal GOOGLE_CALLBACK_URL character for character.
# Leave blank and the Google button returns 503 instead of breaking the rest of auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# VNPay. Register a sandbox merchant at sandbox.vnpayment.vn to get these.
# Leave blank and checkout stays simulated, which is what keeps local dev runnable.
# VNPAY_RETURN_URL is where the customer lands back; the IPN URL is configured in VNPay's
# portal and must point at <this server>/api/billing/vnpay/ipn.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5000/api/billing/vnpay/return
