generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  /// Migrations take a Postgres advisory lock, and an advisory lock is session-scoped. Neon's
  /// `-pooler` endpoint is PgBouncer in transaction mode, where a session is not guaranteed to
  /// be the same backend twice, so `migrate deploy` can sit there until it times out:
  /// "Timed out trying to acquire a postgres advisory lock". Point this at the Neon URL
  /// *without* `-pooler`; the app itself keeps using the pooled one.
  directUrl = env("DIRECT_URL")
}

enum GlobalRole {
  ADMIN
  USER
}

enum ProjectRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum PlanTier {
  FREE
  PRO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMMENTED
  MENTIONED
  DEADLINE_APPROACHING
  PROJECT_INVITE
  FILE_UPLOADED
  CHAT_MESSAGE
  BLOCKER_RAISED
  ANNOUNCEMENT
  PROJECT_UPDATED
}

/// How much a blocker is hurting. Reuses nothing from Priority on purpose: a task's priority is
/// chosen by whoever plans it, while this describes damage already being done.
enum BlockerImpact {
  BLOCKING
  SERIOUS
  MINOR
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  username             String     @unique
  // Null for accounts created through Google: there is no password to compare against, and
  // password login refuses them by name rather than failing with "invalid credentials".
  passwordHash         String?
  googleId             String?    @unique
  displayName          String
  avatarUrl            String?
  // Storage key of the uploaded avatar, so the old blob can be deleted when it is replaced.
  // Null when the avatar is an external URL or was never set.
  avatarKey            String?
  // TOTP two-factor. The secret exists as soon as setup starts but only counts once
  // twoFactorEnabled flips, so an abandoned setup never locks anyone out.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean    @default(false)
  // bcrypt hashes of single-use recovery codes; the plaintext is shown once and never stored.
  twoFactorBackupCodes String[]
  globalRole           GlobalRole @default(USER)
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  projectMemberships ProjectMember[]
  assignedTasks      Task[]                  @relation("TaskAssignee")
  createdTasks       Task[]                  @relation("TaskCreator")
  comments           Comment[]
  notifications      Notification[]
  timeLogs           TimeLog[]
  files              File[]
  refreshTokens      RefreshToken[]
  sentMentions       Mention[]
  messages           Message[]
  messageMentions    MessageMention[]
  blockersRaised     Blocker[]               @relation("BlockersRaised")
  blockersResolved   Blocker[]               @relation("BlockersResolved")
  notificationPrefs  NotificationPreference?
  subscription       Subscription?
  payments           Payment[]
}

/// One row per user. A user without a row is treated as FREE.
model Subscription {
  id                String             @id @default(uuid())
  userId            String             @unique
  tier              PlanTier           @default(FREE)
  status            SubscriptionStatus @default(ACTIVE)
  cycle             BillingCycle?
  startedAt         DateTime?
  /// When the paid period runs out. Null on FREE.
  currentPeriodEnd  DateTime?
  /// Keeps Pro until the period ends instead of cutting access immediately.
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]
}

/// Invoice history. `provider` records which gateway produced it.
model Payment {
  id             String        @id @default(uuid())
  subscriptionId String
  userId         String
  /// Minor-unit free: VND has no cents, so this is a plain dong amount.
  amount         Int
  currency       String        @default("VND")
  cycle          BillingCycle
  status         PaymentStatus @default(PENDING)
  provider       String        @default("MOCK")
  providerRef    String        @unique
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                  String  @id @default(uuid())
  userId              String  @unique
  taskAssigned        Boolean @default(true)
  taskUpdated         Boolean @default(true)
  taskCommented       Boolean @default(true)
  mentioned           Boolean @default(true)
  deadlineApproaching Boolean @default(true)
  projectInvite       Boolean @default(true)
  fileUploaded        Boolean @default(false)
  // Off by default: a busy project chat would otherwise bury every other notification. Being
  // @mentioned in chat is governed by `mentioned`, which is on, so this only gates the firehose.
  chatMessage         Boolean @default(false)
  blockerRaised       Boolean @default(true)
  announcement        Boolean @default(true)
  projectUpdated      Boolean @default(true)
  emailEnabled        Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  startDate   DateTime?
  endDate     DateTime?
  coverColor  String?       @default("#6366f1")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members       ProjectMember[]
  tasks         Task[]
  comments      Comment[]
  files         File[]
  tags          ProjectTag[]
  columns       KanbanColumn[]
  messages      Message[]
  blockers      Blocker[]
  notifications Notification[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  color    String       @default("#6366f1")
  projects ProjectTag[]
  tasks    TaskTag[]
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model KanbanColumn {
  id        String  @id @default(uuid())
  projectId String
  name      String
  order     Int
  color     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  columnId     String?
  parentId     String?
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  priority     Priority   @default(MEDIUM)
  assigneeId   String?
  creatorId    String
  order        Float
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  estimatedHrs Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column   KanbanColumn? @relation(fields: [columnId], references: [id])
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User          @relation("TaskCreator", fields: [creatorId], references: [id])
  parent   Task?         @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[]        @relation("Subtasks")

  comments      Comment[]
  files         File[]
  timeLogs      TimeLog[]
  tags          TaskTag[]
  blockedBy     TaskDependency[] @relation("BlockedTask")
  blocking      TaskDependency[] @relation("BlockingTask")
  notifications Notification[]
  blockers      Blocker[]
}

model TaskDependency {
  id             String @id @default(uuid())
  blockingTaskId String
  blockedTaskId  String

  blockingTask Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  blockedTask  Task @relation("BlockedTask", fields: [blockedTaskId], references: [id], onDelete: Cascade)

  @@unique([blockingTaskId, blockedTaskId])
}

model TaskTag {
  taskId String
  tagId  String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Comment {
  id        String    @id @default(uuid())
  authorId  String
  taskId    String?
  projectId String?
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author  User     @relation(fields: [authorId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  files    File[]
  mentions Mention[]
}

model Mention {
  id          String @id @default(uuid())
  commentId   String
  mentionedId String

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentioned User    @relation(fields: [mentionedId], references: [id])

  @@unique([commentId, mentionedId])
}

/// A line in a project's chat. Separate from Comment because a comment is attached to a task and
/// is part of that task's record; this is conversation, and deleting it loses nothing.
model Message {
  id        String    @id @default(uuid())
  projectId String
  authorId  String
  body      String
  /// Pinned messages are the "important announcement" case — the same row, raised in the UI and
  /// notified to everyone rather than only to people who were mentioned.
  pinned    Boolean   @default(false)
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id])
  mentions MessageMention[]

  @@index([projectId, createdAt])
}

model MessageMention {
  id          String @id @default(uuid())
  messageId   String
  mentionedId String

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentioned User    @relation(fields: [mentionedId], references: [id])

  @@unique([messageId, mentionedId])
}

/// Something going wrong that the team needs to see — a dependency that has not arrived, a
/// decision nobody has made, a member who has gone quiet. Not a task: a task is work someone
/// owns, this is an obstacle in front of the work, and it is resolved rather than completed.
model Blocker {
  id           String        @id @default(uuid())
  projectId    String
  raisedById   String
  /// The task it is holding up, when it is only one.
  taskId       String?
  title        String
  description  String?
  impact       BlockerImpact @default(SERIOUS)
  status       BlockerStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raisedBy   User    @relation("BlockersRaised", fields: [raisedById], references: [id])
  resolvedBy User?   @relation("BlockersResolved", fields: [resolvedById], references: [id])
  task       Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model File {
  id           String   @id @default(uuid())
  uploaderId   String
  taskId       String?
  projectId    String?
  commentId    String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  url          String
  createdAt    DateTime @default(now())

  uploader User     @relation(fields: [uploaderId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  type        NotificationType
  taskId      String?
  // Set for anything that does not hang off a task — chat, blockers, announcements — so the
  // client knows where to send someone who clicks it.
  projectId   String?
  message     String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead])
}

model TimeLog {
  id          String    @id @default(uuid())
  userId      String
  taskId      String
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?
  note        String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
